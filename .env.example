# Copy to .env for local overrides (never commit .env).

# App database (matches docker-compose.yml defaults)
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5433

# Sidekiq / Redis (app queue, not Judge0's Redis)
REDIS_URL=redis://localhost:6379/0

# Judge0 CE API
JUDGE0_URL=http://localhost:2358

# URL Judge0 workers use to reach Rails (Docker Desktop -> host)
JUDGE0_CALLBACK_BASE_URL=http://host.docker.internal:3000

# Shared secret for POST /judge0/webhook (query ?secret= or X-Judge0-Secret)
JUDGE0_WEBHOOK_SECRET=dev-judge0-webhook-secret
