<% content_for :title, "#{t("submissions.detail_title", id: @submission.id)} - ThetaRush" %>

<section class="page-header">
  <h1><%= t("submissions.detail_title", id: @submission.id) %></h1>
  <p class="page-lede">
    <%= link_to @problem.title, problem_path(@problem) %>
  </p>
  <div class="cluster" style="margin-top: var(--space-3)">
    <%= verdict_badge(@submission.status) %>
    <% if @submission.time_ms.present? %>
      <span class="page-meta"><%= t("submissions.time") %>: <%= @submission.time_ms %> ms</span>
    <% end %>
    <% if @submission.memory_kb.present? %>
      <span class="page-meta"><%= t("submissions.memory") %>: <%= format_memory(@submission.memory_kb) %></span>
    <% end %>
    <span class="page-meta"><%= t("submissions.language") %>: <%= language_label(@submission.language) %></span>
  </div>
  <p class="page-meta" style="margin-top: var(--space-2)">
    <% if %w[queued judging].include?(@submission.status) %>
      <%= t("submissions.judging") %>
    <% else %>
      <%= t("submissions.finished") %>
    <% end %>
  </p>
</section>

<section class="code-panel" data-controller="clipboard" data-clipboard-copied-value="<%= t("submissions.copied") %>">
  <button type="button" class="button button--sm code-panel__copy" data-clipboard-target="button" data-action="clipboard#copy">
    <%= t("submissions.copy") %>
  </button>
  <pre data-clipboard-target="source"><%= @submission.source_code %></pre>
</section>

<div class="accordion" style="margin-top: var(--space-5)">
  <% if @submission.compile_output.present? %>
    <details open>
      <summary><%= t("submissions.compile_output") %></summary>
      <pre class="sample"><%= @submission.compile_output %></pre>
    </details>
  <% end %>

  <% if @submission.stderr.present? %>
    <details open>
      <summary><%= t("submissions.stderr") %></summary>
      <pre class="sample"><%= @submission.stderr %></pre>
    </details>
  <% end %>

  <% if @submission.stdout.present? && @submission.status == "ac" %>
    <details>
      <summary><%= t("submissions.stdout") %></summary>
      <pre class="sample"><%= @submission.stdout %></pre>
    </details>
  <% end %>
</div>

<div class="cluster" style="margin-top: var(--space-5)">
  <% if %w[queued judging].include?(@submission.status) %>
    <%= link_to t("submissions.refresh"), submission_path(@submission), class: "button" %>
  <% end %>
  <%= link_to t("submissions.back_to_problem"), problem_path(@problem), class: "button button--ghost" %>
  <%= link_to t("problems.all_submissions"), submissions_path, class: "button button--secondary" %>
</div>
