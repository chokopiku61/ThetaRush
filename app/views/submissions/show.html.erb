<% content_for :title, "Submission ##{@submission.id} - ThetaRush" %>

<section class="page-header">
  <h1>Submission #<%= @submission.id %></h1>
  <p class="page-lede">Placeholder result screen. Real verdicts arrive with Judge0 later.</p>
</section>

<p class="placeholder-note">No judging backend yet. This page shows the layout for a queued submission.</p>

<div class="surface stack stack--tight">
  <p>
    Problem:
    <% if @problem %>
      <%= link_to @problem.title, problem_path(@problem.id) %>
    <% else %>
      <%= @submission.problem_title %>
    <% end %>
  </p>
  <p>Language: <strong><%= @submission.language %></strong></p>
  <p>Status: <%= verdict_badge(@submission.verdict) %></p>
  <p class="page-meta">Submitted at <%= l(@submission.submitted_at, format: :short) rescue @submission.submitted_at %></p>
</div>

<div class="cluster" style="margin-top: var(--space-5)">
  <% if @problem %>
    <%= link_to "Back to problem", problem_path(@problem.id), class: "button button--ghost" %>
  <% end %>
  <%= link_to "Problem catalog", problems_path, class: "button button--secondary" %>
</div>
