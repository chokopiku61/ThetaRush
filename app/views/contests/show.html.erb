<% content_for :title, "#{@contest.title} - ThetaRush" %>

<section class="page-header">
  <div class="cluster" style="justify-content: space-between">
    <h1 style="margin: 0"><%= @contest.title %></h1>
    <%= render "shared/favorite_button", record: @contest, favorite: @favorite %>
  </div>
  <p class="page-lede"><%= @contest.description %></p>
  <p class="page-meta">
    <%= contest_status_label(@contest.status) %>
    · <%= l(@contest.starts_at, format: :short) rescue @contest.starts_at %>
    -
    <%= l(@contest.ends_at, format: :short) rescue @contest.ends_at %>
  </p>
</section>

<div class="cluster" style="margin-bottom: var(--space-5)">
  <% if @participation %>
    <span class="badge badge--ac"><%= t("contests.registered_badge") %></span>
  <% elsif user_signed_in? && %w[upcoming running].include?(@contest.status) %>
    <%= button_to t("contests.register"), register_contest_path(@contest.id), method: :post, class: "button" %>
  <% elsif !user_signed_in? %>
    <%= link_to t("contests.sign_in_to_register"), new_user_session_path, class: "button" %>
  <% else %>
    <span class="page-meta"><%= t("contests.registration_closed_label") %></span>
  <% end %>
  <% if current_user&.admin? && @contest.ends_at.past? && @contest.status != "finalized" %>
    <%= button_to t("contests.finalize"), finalize_contest_path(@contest.id), method: :post, class: "button" %>
  <% end %>
  <%= link_to t("contests.scoreboard"), scoreboard_contest_path(@contest.id), class: "button button--secondary" %>
  <%= link_to t("contests.all"), contests_path, class: "button button--ghost" %>
</div>

<section class="stack">
  <h2><%= t("contests.problems") %></h2>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th><%= t("contests.columns.letter") %></th>
          <th><%= t("contests.columns.title") %></th>
          <th><%= t("contests.columns.rating") %></th>
        </tr>
      </thead>
      <tbody>
        <% @contest_problems.each do |entry| %>
          <tr>
            <td class="num"><%= entry.letter %></td>
            <td><%= link_to entry.problem.title, problem_path(entry.problem, contest_id: @contest.id) %></td>
            <td><span class="<%= rating_pill_class(entry.problem.rating) %>"><%= entry.problem.rating %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
