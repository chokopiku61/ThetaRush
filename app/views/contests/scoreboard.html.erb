<% content_for :title, "Scoreboard - #{@contest.title} - ThetaRush" %>

<section class="page-header">
  <h1>Scoreboard</h1>
  <p class="page-lede"><%= @contest.title %> · ICPC-style standings.</p>
  <p class="page-meta">
    <%= link_to "Back to contest", contest_path(@contest.id) %>
  </p>
</section>

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th>#</th>
        <th>Handle</th>
        <th>Solved</th>
        <th>Penalty</th>
      </tr>
    </thead>
    <tbody>
      <% @rows.each do |row| %>
        <tr>
          <td class="num"><%= row.rank || "-" %></td>
          <td><%= row.user.username %></td>
          <td class="num"><%= row.solved_count %></td>
          <td class="num"><%= row.penalty %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @rows.empty? %>
  <p class="empty-state">No participants have registered yet.</p>
<% end %>
