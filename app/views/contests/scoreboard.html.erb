<% content_for :title, "#{t("contests.scoreboard_title")} - #{@contest.title} - ThetaRush" %>

<section class="page-header">
  <h1><%= t("contests.scoreboard_title") %></h1>
  <p class="page-lede"><%= t("contests.scoreboard_lede", title: @contest.title) %></p>
  <p class="page-meta">
    <%= link_to t("contests.back_to_contest"), contest_path(@contest.id) %>
  </p>
</section>

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th><%= t("contests.columns.rank") %></th>
        <th><%= t("contests.columns.handle") %></th>
        <th><%= t("contests.columns.solved") %></th>
        <th><%= t("contests.columns.penalty") %></th>
      </tr>
    </thead>
    <tbody>
      <% @rows.each do |row| %>
        <tr>
          <td class="num"><%= row.rank || "-" %></td>
          <td><%= row.user.username %></td>
          <td class="num"><%= row.solved_count %></td>
          <td class="num"><%= row.penalty %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @rows.empty? %>
  <p class="empty-state"><%= t("contests.no_participants") %></p>
<% end %>
