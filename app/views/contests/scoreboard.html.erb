<% content_for :title, "#{t("contests.scoreboard_title")} - #{@contest.title} - ThetaRush" %>

<section class="page-header">
  <h1><%= t("contests.scoreboard_title") %></h1>
  <p class="page-lede"><%= t("contests.scoreboard_lede", title: @contest.title) %></p>
  <p class="page-meta">
    <%= link_to t("contests.back_to_contest"), contest_path(@contest.id) %>
  </p>
</section>

<% if user_signed_in? %>
  <%= turbo_stream_from @contest, :scoreboard,
        channel: ScoreboardChannel,
        data: { contest_id: @contest.id } %>
<% end %>

<p class="page-meta"><%= t("contests.scoreboard_updates") %></p>

<%= turbo_frame_tag "scoreboard" do %>
  <p class="page-meta">
    <%= link_to t("contests.refresh_scoreboard"), scoreboard_contest_path(@contest), data: { turbo_frame: "scoreboard" } %>
  </p>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th><%= t("contests.columns.rank") %></th>
          <th><%= t("contests.columns.handle") %></th>
          <th><%= t("contests.columns.solved") %></th>
          <th><%= t("contests.columns.penalty") %></th>
        </tr>
      </thead>
      <%= render "scoreboard_rows", rows: @rows %>
    </table>
  </div>
<% end %>
