<% content_for :title, "Contests - ThetaRush" %>

<section class="page-header">
  <h1>Contests</h1>
  <p class="page-lede">Tournaments and daily sprints. Placeholder list for UI review.</p>
</section>

<p class="placeholder-note">Fake data only. Contest generation and registration land in a later milestone.</p>

<ul class="card-list">
  <% @contests.each do |contest| %>
    <li>
      <%= link_to contest_path(contest.id), class: "contest-card" do %>
        <h2 class="contest-card__title"><%= contest.title %></h2>
        <p class="contest-card__meta">
          <%= contest_status_label(contest.status) %>
          · <%= contest.problem_count %> problems
          · <%= contest.registered_count %> registered
          · <%= l(contest.starts_at, format: :short) rescue contest.starts_at %>
        </p>
      <% end %>
    </li>
  <% end %>
</ul>
