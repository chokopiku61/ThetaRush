<% content_for :title, "#{t("profile.title")} - ThetaRush" %>

<section class="page-header">
  <h1><%= t("profile.title") %></h1>
  <p class="page-lede"><%= t("profile.lede") %></p>
</section>

<section class="surface profile-header">
  <div>
    <h2 class="profile-header__name"><%= current_user.username %></h2>
    <p class="profile-header__email"><%= current_user.email %></p>
    <p class="page-meta">
      <span class="<%= rating_pill_class(current_user.rating) %>"><%= t("profile.current_rating") %> <%= current_user.rating %></span>
      · <%= t("profile.max_rating") %> <%= current_user.max_rating %>
    </p>
  </div>
  <div class="profile-stats">
    <div>
      <strong><%= @contests_played %></strong>
      <span><%= t("profile.contests_played") %></span>
    </div>
    <div>
      <strong><%= @problems_solved %></strong>
      <span><%= t("profile.problems_solved") %></span>
    </div>
  </div>
</section>

<section class="surface" style="margin-top: var(--space-5)">
  <div class="cluster" style="justify-content: space-between">
    <h2 style="margin:0"><%= t("profile.rating_history") %></h2>
  </div>
  <% chart_points = @rating_histories.reverse %>
  <% if chart_points.size >= 2 %>
    <% values = chart_points.map(&:new_rating) %>
    <% min_v = values.min
       max_v = [values.max, min_v + 1].max
       width = 600
       height = 160
       pts = values.each_with_index.map do |v, i|
         x = (i.to_f / (values.size - 1)) * (width - 20) + 10
         y = height - 10 - ((v - min_v).to_f / (max_v - min_v)) * (height - 20)
         [x.round(1), y.round(1)]
       end
       path = pts.map.with_index { |(x, y), i| "#{i.zero? ? "M" : "L"}#{x} #{y}" }.join(" ") %>
    <svg class="rating-chart" viewBox="0 0 <%= width %> <%= height %>" role="img" aria-label="<%= t("profile.rating_history") %>">
      <path d="<%= path %>"/>
      <% pts.each do |x, y| %>
        <circle cx="<%= x %>" cy="<%= y %>" r="3"/>
      <% end %>
    </svg>
  <% end %>

  <div class="table-wrap" style="margin-top: var(--space-4)">
    <table class="table">
      <thead>
        <tr>
          <th><%= t("profile.columns.contest") %></th>
          <th><%= t("profile.columns.rank") %></th>
          <th><%= t("profile.columns.change") %></th>
          <th><%= t("profile.columns.rating") %></th>
        </tr>
      </thead>
      <tbody>
        <% if @rating_histories.empty? %>
          <tr><td colspan="4"><%= t("profile.no_history") %></td></tr>
        <% else %>
          <% @rating_histories.each do |history| %>
            <tr>
              <td><%= link_to history.contest.title, contest_path(history.contest) %></td>
              <td class="num"><%= history.rank %></td>
              <td class="num"><%= "%+d" % (history.new_rating - history.old_rating) %></td>
              <td class="num"><%= history.new_rating %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="stack" style="margin-top: var(--space-5)">
  <div class="cluster" style="justify-content: space-between">
    <h2 style="margin:0"><%= t("profile.recent_submissions") %></h2>
    <%= link_to t("profile.view_all"), submissions_path, class: "page-meta" %>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th><%= t("profile.columns.problem") %></th>
          <th><%= t("profile.columns.language") %></th>
          <th><%= t("profile.columns.verdict") %></th>
          <th><%= t("profile.columns.when") %></th>
        </tr>
      </thead>
      <tbody>
        <% if @recent_submissions.empty? %>
          <tr><td colspan="4"><%= t("profile.no_submissions") %></td></tr>
        <% else %>
          <% @recent_submissions.each do |submission| %>
            <tr>
              <td><%= link_to submission.problem.title, submission_path(submission) %></td>
              <td><%= language_label(submission.language) %></td>
              <td><%= verdict_badge(submission.status) %></td>
              <td class="num"><%= time_ago_label(submission.submitted_at) %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
