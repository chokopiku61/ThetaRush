<% content_for :title, "ThetaRush" %>
<% content_for :wide_main, "1" %>

<section class="home" data-controller="matrix-rain">
  <canvas class="home__canvas" data-matrix-rain-target="canvas" aria-hidden="true"></canvas>
  <div class="home__content">
    <%= image_tag "logo.png", alt: "ThetaRush", class: "home__logo" %>
    <h1 class="home__title"><%= t("home.title") %></h1>
    <p class="home__tagline"><%= t("home.tagline") %></p>
    <div class="cluster home__actions">
      <%= link_to t("home.browse_problems"), problems_path, class: "button" %>
      <%= link_to t("home.join_contests"), contests_path, class: "button button--secondary" %>
    </div>
    <div class="home__stats">
      <div class="home__stat">
        <strong><%= number_with_delimiter(@problems_count) %></strong>
        <span><%= t("home.problems") %></span>
      </div>
      <div class="home__stat">
        <strong><%= number_with_delimiter(@contests_count) %></strong>
        <span><%= t("home.contests") %></span>
      </div>
      <div class="home__stat">
        <strong><%= number_with_delimiter(@users_count) %></strong>
        <span><%= t("home.users") %></span>
      </div>
    </div>
  </div>
</section>
