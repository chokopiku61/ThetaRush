<% content_for :title, "Problems - ThetaRush" %>

<section class="page-header">
  <h1>Problems</h1>
  <p class="page-lede">Practice catalog. Placeholder problems for UI review.</p>
</section>

<p class="placeholder-note">Fake data only. Real problems arrive with the importer later.</p>

<ul class="card-list">
  <% @problems.each do |problem| %>
    <li>
      <%= link_to problem_path(problem.id), class: "problem-card" do %>
        <h2 class="problem-card__title">
          <%= problem.title %>
          <span class="rating-pill"><%= problem.rating %></span>
        </h2>
        <p class="problem-card__meta">
          <%= problem.tags.join(", ") %>
          · <%= problem.solved_count %> solved
          · <%= problem.time_limit_ms %> ms / <%= problem.memory_limit_mb %> MB
        </p>
      <% end %>
    </li>
  <% end %>
</ul>
