<% content_for :title, "#{@contest_problem ? "#{@contest_problem.letter}. " : ""}#{@problem.title} - ThetaRush" %>
<% content_for :wide_main, "1" %>
<% default_source = "a, b = map(int, input().split())\nprint(a + b)\n" %>
<% can_edit = user_signed_in? %>
<% can_submit = user_signed_in? && (!@contest || @contest_accepting_submissions) %>

<% if @contest %>
  <%= render "problems/contest_strip", contest: @contest %>
<% end %>

<div
  class="workspace"
  data-controller="split-pane<%= " editor file-upload custom-run" if can_edit %>"
  <% if can_edit %>
    data-custom-run-url-value="<%= problem_custom_runs_path(@problem) %>"
    data-custom-run-csrf-value="<%= form_authenticity_token %>"
    data-editor-language-value="python"
  <% end %>
>
  <div class="workspace__pane workspace__pane--statement" data-split-pane-target="left">
    <% if @contest && @contest_problems.present? %>
      <nav class="contest-nav" aria-label="<%= t("problems.contest_problems") %>">
        <% if @previous_contest_problem %>
          <%= link_to t("problems.previous"),
                problem_path(@previous_contest_problem.problem, contest_id: @contest.id),
                class: "contest-nav__adjacent",
                rel: "prev" %>
        <% else %>
          <span class="contest-nav__adjacent contest-nav__adjacent--disabled" aria-disabled="true"><%= t("problems.previous") %></span>
        <% end %>

        <div class="contest-nav__letters" role="list">
          <% statuses = @contest_problem_statuses || {} %>
          <% @contest_problems.each do |entry| %>
            <%= link_to entry.letter,
                  problem_path(entry.problem, contest_id: @contest.id),
                  class: contest_problem_letter_class(statuses[entry.problem_id], active: entry.id == @contest_problem.id),
                  role: "listitem",
                  aria: { current: (entry.id == @contest_problem.id ? "page" : nil) },
                  title: "#{entry.letter}. #{entry.problem.title}" %>
          <% end %>
        </div>

        <% if @next_contest_problem %>
          <%= link_to t("problems.next"),
                problem_path(@next_contest_problem.problem, contest_id: @contest.id),
                class: "contest-nav__adjacent",
                rel: "next" %>
        <% else %>
          <span class="contest-nav__adjacent contest-nav__adjacent--disabled" aria-disabled="true"><%= t("problems.next") %></span>
        <% end %>
      </nav>
    <% end %>

    <div class="cluster" style="justify-content: space-between; margin-bottom: var(--space-3)">
      <h1 style="margin: 0; font-size: var(--text-2xl)">
        <% if @contest_problem %>
          <span class="workspace__letter"><%= @contest_problem.letter %>.</span>
        <% end %>
        <%= @problem.title %>
      </h1>
      <%= render "shared/favorite_button", record: @problem, favorite: @favorite %>
    </div>

    <ul class="limits">
      <li><span class="<%= rating_pill_class(@problem.rating) %>"><%= @problem.rating %></span></li>
      <% @problem.tags.each do |tag| %>
        <li><span class="tag"><%= tag %></span></li>
      <% end %>
      <li><%= t("problems.time_limit") %>: <%= @problem.time_limit_ms %> ms</li>
      <li><%= t("problems.memory_limit") %>: <%= @problem.memory_limit_mb %> MB</li>
      <li><%= t("problems.solved") %>: <%= @solved_count %></li>
    </ul>

    <% unless @contest %>
      <p class="page-meta" style="margin-bottom: var(--space-4)">
        <%= link_to t("problems.back_to_catalog"), problems_path %>
      </p>
    <% end %>

    <article class="statement">
      <%= simple_format(h(@problem.statement)) %>

      <% if @problem.sample_input.present? || @problem.sample_output.present? %>
        <h3>Samples</h3>
        <%= tag.div class: "sample-card",
              data: {
                custom_run_target: "sample",
                stdin: @problem.sample_input.to_s,
                expected: @problem.sample_output.to_s
              } do %>
          <div class="sample-card__header">
            <span class="sample-card__title">Sample 1</span>
            <% if can_edit %>
              <%= button_tag "▶",
                    type: "button",
                    class: "button button--ghost button--sm sample-card__play",
                    title: t("editor.play_sample"),
                    aria: { label: t("editor.play_sample") },
                    data: {
                      action: "custom-run#playSample",
                      stdin: @problem.sample_input.to_s,
                      expected: @problem.sample_output.to_s
                    } %>
            <% end %>
          </div>
          <div class="sample-grid">
            <div>
              <p><strong>Input</strong></p>
              <pre class="sample"><%= @problem.sample_input %></pre>
            </div>
            <div>
              <p><strong>Output</strong></p>
              <pre class="sample"><%= @problem.sample_output %></pre>
            </div>
          </div>
        <% end %>
      <% end %>
    </article>
  </div>

  <div
    class="workspace__divider"
    data-split-pane-target="divider"
    data-action="pointerdown->split-pane#start"
    role="separator"
    aria-orientation="vertical"
    tabindex="0"
  ></div>

  <div class="workspace__pane workspace__pane--editor">
    <% if can_edit %>
      <% if can_submit %>
        <%= form_with url: problem_submissions_path(@problem), method: :post, class: "form workspace__editor-form", data: { turbo: true } do %>
          <%= hidden_field_tag :contest_id, @contest.id if @contest %>
          <%= render "problems/editor_chrome",
                problem: @problem,
                languages: @languages,
                default_source: default_source,
                can_submit: true,
                recent_submissions: @recent_submissions %>
        <% end %>
      <% else %>
        <div class="workspace__editor-form">
          <% if @contest %>
            <div class="alert alert--info" style="margin: 0.75rem">
              <%= t("problems.contest_closed") %>
            </div>
          <% end %>
          <%= render "problems/editor_chrome",
                problem: @problem,
                languages: @languages,
                default_source: default_source,
                can_submit: false,
                recent_submissions: @recent_submissions %>
        </div>
      <% end %>
    <% else %>
      <div class="workspace__editor-body">
        <div class="alert alert--info">
          <%= link_to t("nav.log_in"), new_user_session_path %> - <%= t("problems.sign_in_to_submit") %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<style>
  .visually-hidden {
    position: absolute !important;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }
</style>
