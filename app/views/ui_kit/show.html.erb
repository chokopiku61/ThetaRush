<% content_for :title, "UI kit - ThetaRush" %>

<section class="page-header">
  <h1>UI kit</h1>
  <p class="page-lede">Dark surfaces, purple accent, verdict badges, forms, tables, and navigation samples.</p>
</section>

<nav aria-label="UI kit sections">
  <ul class="ui-kit-toc">
    <li><a href="#typography">Typography</a></li>
    <li><a href="#colors">Colors</a></li>
    <li><a href="#buttons">Buttons</a></li>
    <li><a href="#forms">Forms</a></li>
    <li><a href="#tables">Tables</a></li>
    <li><a href="#alerts">Alerts</a></li>
    <li><a href="#badges">Badges</a></li>
    <li><a href="#rating">Rating</a></li>
    <li><a href="#navigation">Navigation</a></li>
  </ul>
</nav>

<section class="ui-kit-section surface" id="typography">
  <h2>Typography</h2>
  <p class="ui-kit-section__lede">Display, body, and monospace faces used across the product.</p>
  <p class="type-sample type-sample--display">Space Grotesk display</p>
  <p class="type-sample type-sample--body">Source Sans 3 body copy for statements and UI labels.</p>
  <p class="type-sample type-sample--mono">IBM Plex Mono — code and timestamps</p>
</section>

<section class="ui-kit-section surface" id="colors">
  <h2>Colors</h2>
  <p class="ui-kit-section__lede">Core surfaces and accent tokens from the dark theme.</p>
  <div class="swatch-row">
    <div class="swatch">
      <div class="swatch__chip" style="background: var(--color-bg)"></div>
      <div class="swatch__label">bg</div>
    </div>
    <div class="swatch">
      <div class="swatch__chip" style="background: var(--color-surface)"></div>
      <div class="swatch__label">surface</div>
    </div>
    <div class="swatch">
      <div class="swatch__chip" style="background: var(--color-accent)"></div>
      <div class="swatch__label">accent</div>
    </div>
    <div class="swatch">
      <div class="swatch__chip" style="background: var(--color-accent-soft)"></div>
      <div class="swatch__label">accent-soft</div>
    </div>
    <div class="swatch">
      <div class="swatch__chip" style="background: var(--color-border)"></div>
      <div class="swatch__label">border</div>
    </div>
    <div class="swatch">
      <div class="swatch__chip" style="background: var(--color-text)"></div>
      <div class="swatch__label">text</div>
    </div>
  </div>
</section>

<section class="ui-kit-section surface" id="buttons">
  <h2>Buttons</h2>
  <div class="ui-kit-row">
    <a href="#" class="button">Primary</a>
    <a href="#" class="button button--secondary">Secondary</a>
    <a href="#" class="button button--ghost">Ghost</a>
  </div>
</section>

<section class="ui-kit-section surface" id="forms">
  <h2>Forms</h2>
  <p class="ui-kit-section__lede">Inputs for search, language select, and the code editor textarea.</p>
  <form class="form" style="max-width: 28rem" onsubmit="return false">
    <div class="field">
      <label>Input</label>
      <input class="input" type="text" placeholder="Search problems">
    </div>
    <div class="field">
      <label>Select</label>
      <select class="select">
        <option>Python</option>
        <option>C++</option>
      </select>
    </div>
    <div class="field">
      <label>Code</label>
      <textarea class="textarea textarea--code" rows="5">a, b = map(int, input().split())
print(a + b)</textarea>
    </div>
  </form>
</section>

<section class="ui-kit-section surface" id="tables">
  <h2>Tables</h2>
  <p class="ui-kit-section__lede">Problem catalog and scoreboard-style rows.</p>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th class="num">#</th>
          <th>Title</th>
          <th>Rating</th>
          <th>Verdict</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="num">1</td>
          <td>A + B</td>
          <td><span class="rating-pill rating-pill--newbie">800</span></td>
          <td><%= verdict_badge("ac") %></td>
        </tr>
        <tr>
          <td class="num">2</td>
          <td>Two Sum</td>
          <td><span class="rating-pill rating-pill--pupil">1400</span></td>
          <td><%= verdict_badge("wa") %></td>
        </tr>
        <tr>
          <td class="num">3</td>
          <td>Shortest Path</td>
          <td><span class="rating-pill rating-pill--expert">1700</span></td>
          <td><%= verdict_badge("tle") %></td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<section class="ui-kit-section surface" id="alerts">
  <h2>Alerts</h2>
  <div class="alert alert--notice">Notice: contest registration is open.</div>
  <div class="alert alert--info" style="margin-top: var(--space-3)">Info: judging queue is healthy.</div>
  <div class="alert alert--warn" style="margin-top: var(--space-3)">Warning: time limit is tight on this problem.</div>
  <div class="alert alert--alert" style="margin-top: var(--space-3)">Alert: submission failed validation.</div>
</section>

<section class="ui-kit-section surface" id="badges">
  <h2>Verdict badges</h2>
  <div class="ui-kit-row">
    <% %w[ac wa tle mle re ce ie queued judging].each do |v| %>
      <%= verdict_badge(v) %>
    <% end %>
  </div>
</section>

<section class="ui-kit-section surface" id="rating">
  <h2>Rating pills</h2>
  <div class="ui-kit-row">
    <span class="rating-pill rating-pill--newbie">800</span>
    <span class="rating-pill rating-pill--pupil">1400</span>
    <span class="rating-pill rating-pill--expert">1700</span>
    <span class="rating-pill rating-pill--master">2100</span>
    <span class="rating-pill rating-pill--grandmaster">2500</span>
  </div>
</section>

<section class="ui-kit-section surface" id="navigation">
  <h2>Navigation</h2>
  <p class="ui-kit-section__lede">Sample top bar using product fonts and muted link treatment.</p>
  <div class="nav-sample">
    <span class="nav-sample__brand">ThetaRush</span>
    <div class="nav-sample__links">
      <a href="<%= problems_path %>">Problems</a>
      <a href="<%= contests_path %>">Contests</a>
      <a href="<%= submissions_path %>">Submissions</a>
      <a href="<%= ui_kit_path %>">UI kit</a>
    </div>
  </div>
</section>
