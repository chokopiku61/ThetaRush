<% content_for :title, "#{t("groups.title")} - ThetaRush" %>

<section class="page-header">
  <h1><%= t("groups.title") %></h1>
  <p class="page-lede"><%= t("groups.lede") %></p>
</section>

<div class="groups-layout">
  <div>
    <% if @groups.empty? %>
      <p class="empty-state"><%= t("groups.empty") %></p>
    <% else %>
      <% @groups.each do |group| %>
        <div class="group-card">
          <%= image_tag "logo.png", alt: "", style: "width:3rem;height:3rem;object-fit:contain" %>
          <div class="group-card__body">
            <h2 class="group-card__title"><%= link_to group.name, group_path(group) %></h2>
            <p class="group-card__meta"><%= t("groups.member_count", count: group.group_memberships.size) %></p>
          </div>
          <% if user_signed_in? %>
            <% if current_user.groups.include?(group) %>
              <%= button_to t("groups.leave"), leave_group_path(group), method: :delete, class: "button button--ghost button--sm" %>
            <% else %>
              <%= button_to t("groups.join"), join_group_path(group), method: :post, class: "button button--sm" %>
            <% end %>
          <% else %>
            <%= link_to t("nav.log_in"), new_user_session_path, class: "button button--sm" %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <aside class="surface">
    <h2 style="margin-top:0"><%= t("groups.create") %></h2>
    <% if user_signed_in? %>
      <%= form_with model: @group, url: groups_path, class: "form" do |f| %>
        <div class="field">
          <%= f.label :name, t("groups.name") %>
          <%= f.text_field :name, class: "input", required: true %>
        </div>
        <div class="field">
          <%= f.label :description, t("groups.description") %>
          <%= f.text_area :description, class: "textarea", rows: 3 %>
        </div>
        <%= f.submit t("groups.create"), class: "button" %>
      <% end %>
    <% else %>
      <p class="page-meta"><%= link_to t("nav.log_in"), new_user_session_path %> <%= t("groups.create").downcase %></p>
    <% end %>
  </aside>
</div>
